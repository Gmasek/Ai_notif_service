# OpenAI Configuration
OPENAI_API_KEY=
# Database Configuration (local state DB — notification flags, firebase tokens)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/app_db

# Firebase Configuration
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json



# ---------------------------------------------------------------------------
# Observation IDs — run  python check_elastic.py  to discover the right values
# ---------------------------------------------------------------------------
# All LimeSurvey surveys share observation_type="lime-survey-observation".
# They are told apart by observation_id, which is the study-manager integer ID
# stored as a string (e.g. "1", "2", "3") in Elasticsearch.
#
# Identify each observation by its data fields in check_elastic.py output:
#   Baseline       → data fields: bigfive[SQ001]..., age, gender, occupation, G01Q36
#   Daily check-in → data fields: Q00[SQ001] (mood), Q00[SQ002] (energy), Q00[SQ006] (stress)
#   PA schedule    → data fields: msgdays[SQ001], msgdays[SQ001comment]
#   Evening        → data fields: Q00 (exercised Y/N), G00Q02 (activity), G00Q03 (duration)
#   Message eval   → custom notification feedback fields


# ---------------------------------------------------------------------------
# MORE Gateway
# ---------------------------------------------------------------------------
MORE_GATEWAY_BASE_URL=https://your-gateway-host
MOMENTARY_ASSESMENT_TOKEN=your-token-here
NOTIFACTION_FEEDBACK_TOKEN=your-token-here
PA_SCHEDULE_UPDATE_TOKEN=your-token-here


LIME_REMOTE_URL=
LIME_ADMIN_USER=                                                                                                                                                                              
LIME_ADMIN_PWD=
LIME_BASELINE_SURVEY_ID=                                                                                                                                                            
LIME_DAILY_CHECKIN_SURVEY_ID=                                                                                                                               
LIME_PA_SCHEDULE_SURVEY_ID=                                                                                                                         
LIME_EVENING_FOLLOWUP_SURVEY_ID=                                                                                                                              
LIME_MESSAGE_EVAL_SURVEY_ID=