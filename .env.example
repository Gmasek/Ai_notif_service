# ---------------------------------------------------------------------------
# Anthropic / Claude
# ---------------------------------------------------------------------------
# Generation uses claude-opus-4-7 (model is currently hard-coded in app/pipelines.py)
ANTHROPIC_API_KEY=
LLM_GENERATION_THREADS=4
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=5.0


# ---------------------------------------------------------------------------
# Database (local state: participant profiles, check-ins, notification state)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/app_db


# ---------------------------------------------------------------------------
# MORE Gateway — triggers in-app surveys for participants
# ---------------------------------------------------------------------------
MORE_GATEWAY_BASE_URL=https://your-gateway-host
# Daily check-in / momentary assessment survey
MOMENTARY_ASSESMENT_TOKEN=your-token-here
# Message-evaluation (notification feedback) survey
NOTIFACTION_FEEDBACK_TOKEN=your-token-here
# Weekly PA-schedule update survey
PA_SCHEDULE_UPDATE_TOKEN=your-token-here
# Evening "did you exercise?" follow-up survey
EVENING_FOLLOW_UP_TOKEN=your-token-here


# ---------------------------------------------------------------------------
# MORE studymanager — notification delivery
# ---------------------------------------------------------------------------
MORE_STUDYMANAGER_BASE_URL=http://host.docker.internal:8080
MORE_STUDY_ID=4
INTERNAL_API_KEY=internal-secret-key


# ---------------------------------------------------------------------------
# LimeSurvey — RemoteControl API + survey IDs
# ---------------------------------------------------------------------------
LIME_REMOTE_URL=
LIME_ADMIN_USER=
LIME_ADMIN_PWD=
LIME_BASELINE_SURVEY_ID=
LIME_DAILY_CHECKIN_SURVEY_ID=
LIME_PA_SCHEDULE_SURVEY_ID=
LIME_EVENING_FOLLOWUP_SURVEY_ID=
LIME_MESSAGE_EVAL_SURVEY_ID=
