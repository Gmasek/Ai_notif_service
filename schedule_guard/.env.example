# Copy to .env and adjust for your deployment.

# How to reach the shared Postgres. Use the `db` hostname if joining the main
# app's Docker network (see DB_NETWORK), otherwise point at host:port.
DATABASE_URL=postgresql://postgres:postgres@db:5432/app_db

# Docker network the main Postgres is on (docker network ls). Usually
# "<main-compose-project>_default", e.g. ai_notif_prototype_default.
DB_NETWORK=ai_notif_prototype_default

# A schedule is considered healthy only if it has at least this many days
# with both a start and end time. Below this it is restored from backup.
MIN_SCHEDULE_DAYS=4

# Where the pre-update snapshot is stored (inside the mounted volume).
BACKUP_FILE=/data/schedule_backup.json

# Cron times are in this timezone. Keep UTC to line up with celery beat, which
# runs update_schedule_fields_task at 21:59 UTC on Sunday.
TZ=UTC
# Backup BEFORE the updater, restore AFTER it:
BACKUP_CRON=50 21 * * 0
RESTORE_CRON=15 22 * * 0
